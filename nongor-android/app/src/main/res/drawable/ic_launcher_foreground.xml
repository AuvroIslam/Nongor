<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground. The adaptive-icon safe zone is the middle 72 of 108, so the mark is
     drawn well inside that: launchers mask this to a circle, squircle or teardrop and anything
     near the edge gets clipped. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ring -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,30 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
        android:strokeColor="#F5A524"
        android:strokeWidth="4.5" />
    <!-- shaft -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,37 L54,82"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5.5" />
    <!-- crossbar -->
    <path
        android:fillColor="#00000000"
        android:pathData="M39,47 L69,47"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5.5" />
    <!-- arms -->
    <path
        android:fillColor="#00000000"
        android:pathData="M31,63 C31,77 42,84 54,84 C66,84 77,77 77,63"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5.5" />
    <!-- flukes -->
    <path
        android:fillColor="#F5A524"
        android:pathData="M24,58 L38,60 L31,71 Z" />
    <path
        android:fillColor="#F5A524"
        android:pathData="M84,58 L70,60 L77,71 Z" />
</vector>
