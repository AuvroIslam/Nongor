<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The system splash is flat brand teal with no icon, so the only branded moment is the
         in-app splash (anchor + নোঙর) and you never see a big-icon-then-small-icon double. -->
    <style name="Theme.Nongor" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#064A3F</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Nongor.Main</item>
    </style>
    <style name="Theme.Nongor.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F7F6F2</item>
        <item name="android:navigationBarColor">#F7F6F2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
